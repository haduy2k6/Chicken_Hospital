# Local NestJS configuration. Do not commit real secrets.
NODE_ENV=development
PORT=4002
FRONT_ORIGINS=http://localhost:3002

DB_HOST=your-project.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project
DB_PASSWORD=replace-me
# Development can omit DB_SSL_CA. Production should set Supabase CA and keep certificate verification enabled.

ACCESS_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-32-character-minimum-secret
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:4002/auth/google/callback

S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=chicken-case
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Local AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-a-random-32-character-minimum-secret
AI_CALLBACK_SECRET=replace-with-a-different-random-32-character-minimum-secret

# Backpressure: giữ AI service khỏi bị dội job/retry cùng lúc
AI_SUBMIT_TIMEOUT_MS=12000
AI_DISPATCH_PACING_MS=8000
AI_DISPATCH_BATCH_PER_RUN=5
AI_RESUBMIT_COOLDOWN_MS=600000
AI_MAX_RETRY=2
AI_FAIL_AFTER_MS=2700000
AI_CIRCUIT_BASE_OPEN_MS=60000
AI_CIRCUIT_MAX_OPEN_MS=600000
AI_HEALTH_TIMEOUT_MS=10000
AI_DISPATCH_LOCK_TTL_SEC=300
